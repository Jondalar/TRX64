#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# hooks/pre-push — runs the local quality gate and BLOCKS the push on red.
# Installed repo-wide via `scripts/install-hooks.sh` (sets core.hooksPath=hooks),
# so both machines enforce it.
#
# IT LOOKS AT WHAT YOU ARE PUSHING FIRST. A gate belongs to a change, not to an
# operation, and two questions decide it:
#
#   1. Does this push reach a PROTECTED branch? Only main is released from and
#      consumed by anyone else. A feature branch is work in progress; making it
#      pay for a gate taxes the wrong moment, and the merge into main gates it
#      anyway.
#   2. Does it carry CODE? Pushing nine commits of Markdown used to spend a full
#      clippy + release-test + 7-game run proving that documentation had not
#      broken the emulator.
#
# The code test is a whitelist of INERT files, not a blacklist of code. Anything
# the list does not recognise runs the gate — a new file type, a Cargo.toml, a
# build script, a vendored .cpp. Guessing wrong in that direction costs time;
# guessing wrong in the other direction ships a red push to main.
#
# NOTE: nothing else runs these tests. The Gitea action on the NAS is manual and
# builds an image; the GitHub workflows build release binaries and bump the tap.
# This hook is the only thing standing between a red workspace and main.
#
# Escape hatch for a deliberate WIP push (LOUD warning, never the default):
#   GATE_SKIP=1 git push
#
# Inspect the decision without running anything:
#   GATE_DRYRUN=1 git push
#
# Git invokes this with `<remote> <url>` argv and one line per pushed ref on
# stdin: `<local-ref> <local-sha> <remote-ref> <remote-sha>`.
# ─────────────────────────────────────────────────────────────────────────────

if [ "${GATE_SKIP:-0}" = "1" ]; then
  printf '\n' >&2
  printf '  ##############################################################\n' >&2
  printf '  #  GATE_SKIP=1 — quality gate BYPASSED                      #\n' >&2
  printf '  #  This push is UNVERIFIED. You are on the hook for green.   #\n' >&2
  printf '  ##############################################################\n' >&2
  printf '\n' >&2
  exit 0
fi

HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$HOOK_DIR/.." && pwd)
ZERO=0000000000000000000000000000000000000000

# ── which files does this push actually carry? ───────────────────────────────
#
# Empty on stdin, or any range we cannot resolve, means we do not know — and not
# knowing runs the gate.
CHANGED=$(
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ -z "$local_sha" ]; then
      continue
    fi
    if [ "$local_sha" = "$ZERO" ]; then
      # Deleting a branch carries no files. Marked rather than skipped silently,
      # so a delete-plus-push in one command still gates on the push half.
      printf 'BRANCH-DELETION\n'
      continue
    fi
    # Only a protected branch is worth gating. A tag push carries no new commits
    # of its own, and a feature branch gates when it merges.
    # (`if`, not `case`: a case pattern's `)` inside $( ) breaks the parser here.)
    if [ "$_remote_ref" != "refs/heads/main" ] &&
       [ "$_remote_ref" != "refs/heads/master" ]; then
      # Marked, not dropped: "we looked and it does not need gating" must be
      # distinguishable from "we could not look", which runs the gate.
      printf 'NOT-A-PROTECTED-BRANCH\n'
      continue
    fi
    if [ -z "$remote_sha" ] || [ "$remote_sha" = "$ZERO" ]; then
      # New branch — no range to diff. Take every commit not already on a remote.
      for sha in $(git rev-list "$local_sha" --not --remotes 2>/dev/null); do
        git show --pretty=format: --name-only "$sha" 2>/dev/null
      done
    else
      git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null ||
        printf 'UNKNOWN-RANGE\n'
    fi
  done | sed '/^$/d' | sort -u
)

if [ -z "$CHANGED" ]; then
  # Nothing on stdin at all. Nothing was resolved, so nothing is claimed:
  # run the gate rather than assume.
  CHANGED=UNKNOWN-RANGE
fi

# ── is every one of them inert? ──────────────────────────────────────────────
NEEDS_GATE=0
for f in $CHANGED; do
  case "$f" in
    *.md|*.markdown|*.txt|\
    *.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|\
    LICENSE|LICENSE.*|THANKS.md|AUTHORS.txt|.gitignore|.gitattributes|\
    BRANCH-DELETION|NOT-A-PROTECTED-BRANCH)
      ;;
    *)
      NEEDS_GATE=1
      break
      ;;
  esac
done

if [ "$NEEDS_GATE" = "0" ]; then
  COUNT=$(printf '%s\n' "$CHANGED" | wc -l | tr -d ' ')
  printf '\n=== quality gate skipped — %s file(s), no code on a protected branch ===\n\n' "$COUNT" >&2
  [ "${GATE_DRYRUN:-0}" = "1" ] && printf '%s\n' "$CHANGED" >&2
  exit 0
fi

if [ "${GATE_DRYRUN:-0}" = "1" ]; then
  printf '\n=== GATE_DRYRUN — the gate WOULD run. Files that triggered it:\n' >&2
  for f in $CHANGED; do
    case "$f" in
      *.md|*.markdown|*.txt|\
      *.png|*.jpg|*.jpeg|*.gif|*.svg|*.webp|\
      LICENSE|LICENSE.*|THANKS.md|AUTHORS.txt|.gitignore|.gitattributes|\
      BRANCH-DELETION|NOT-A-PROTECTED-BRANCH) ;;
      *) printf '    %s\n' "$f" >&2 ;;
    esac
  done
  printf '\n' >&2
  exit 0
fi

printf '\n=== pre-push quality gate ===\n' >&2
if "$REPO_ROOT/scripts/gate.sh" >&2; then
  # Clear the build cache when it has GROWN, not on every push. 30 GB, set by the owner
  # 2026-09-10.
  #
  # This used to be unconditional, and the comment here argued for that: "a rule with a
  # threshold is a rule someone argues with". What that missed is what the rule costs on
  # the machine it runs on. Wiping `target/debug` after every push guarantees the NEXT
  # gate rebuilds it from zero — and this workspace compiles DuckDB and reSID through a
  # real C++ toolchain via build.rs, so "from zero" is minutes of every core on the box.
  # The owner runs the emulator on that same box. A gate that took 5 minutes warm took 9
  # cold, and the C64 next to it dropped frames for the whole of it, because the machine
  # was busy archiving a few hundred DuckDB object files.
  #
  # So: reclaim the disk when there is disk worth reclaiming (it has reached 57 GB, and
  # 45 GB in a single day of test runs), and otherwise keep the cache warm. `du -sk`
  # because `df` lies about this on macOS — the builder's own measurement is the truth.
  #
  # `target/debug` only, never a full `cargo clean`: /usr/local/bin/trx64cli is a symlink
  # straight into `target/release/`, so wiping that leaves the owner's own command
  # pointing at nothing. Everything here builds --release; the debug tree is pure
  # accumulation from `cargo test`.
  #
  # It runs AFTER the gate, so the gate's own compile is not paid for twice.
  DEBUG_CACHE_LIMIT_KB=$((30 * 1024 * 1024))   # 30 GB
  if [ -d "$REPO_ROOT/target/debug" ]; then
    used_kb=$(du -sk "$REPO_ROOT/target/debug" 2>/dev/null | cut -f1)
    used_kb=${used_kb:-0}
    used_gb=$((used_kb / 1024 / 1024))
    if [ "$used_kb" -ge "$DEBUG_CACHE_LIMIT_KB" ]; then
      rm -rf "$REPO_ROOT/target/debug"
      printf '    build cache cleared: target/debug (%s GB freed, limit 30 GB)\n' "$used_gb" >&2
    else
      printf '    build cache kept warm: target/debug is %s GB of 30 GB\n' "$used_gb" >&2
    fi
  fi
  printf '=== gate GREEN — push allowed ===\n\n' >&2
  exit 0
fi

printf '\n' >&2
printf '=== gate RED — PUSH BLOCKED ===\n' >&2
printf '    Fix the gate above, or bypass this one push with:  GATE_SKIP=1 git push\n\n' >&2
exit 1
