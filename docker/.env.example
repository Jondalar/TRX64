# Copy to `.env` next to compose.sidecars.yml and fill in. `.env` is gitignored:
# a deployment's addressing does not belong in a public repository.

# Host directory holding the per-project play/dumps folders
# (expects <HOST_DATA>/wl-play, wl-dumps, wl2-play, wl2-dumps).
HOST_DATA=/path/to/container-data

# The EXISTING external network the editors already resolve against — not one compose
# creates. Moving it silently breaks the consumer.
LAN_NETWORK=your-bridge-network

# Static addresses. Scan what ANSWERS on the LAN first; do not just continue the pattern.
WL_TRX64_IP=192.168.x.x
WL2_TRX64_IP=192.168.x.x
